{
  "mcpServers": {
    "xcode": {
      "type": "stdio",
      "command": "/usr/bin/xcrun",
      "args": [
        "mcpbridge"
      ],
      "env": {}
    },
    "xcodeproj": {
      "type": "stdio",
      "command": "container",
      "args": [
        "run",
        "--rm",
        "-i",
        "-v",
        "${CLAUDE_PROJECT_DIR:-.}:/workspace",
        "ghcr.io/giginet/xcodeproj-mcp-server:latest",
        "/workspace"
      ],
      "env": {}
    }
  }
}