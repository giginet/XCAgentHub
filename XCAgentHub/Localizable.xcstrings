{
  "sourceLanguage" : "en",
  "strings" : {
    "" : {
      "shouldTranslate" : false
    },
    "“%@” is already in this agent's skills folder, so there is nothing to link to." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」はすでにこのエージェントのスキルフォルダにあるため、リンクする必要はありません。"
          }
        }
      }
    },
    "“%@” links into %@, which this app cannot read. Import that folder directly instead, or replace the link with a copy." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” links into %2$@, which this app cannot read. Import that folder directly instead, or replace the link with a copy."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」は %2$@ へのリンクですが、このアプリからは読み取れません。そのフォルダを直接読み込むか、リンクを実体のコピーに置き換えてください。"
          }
        }
      }
    },
    "/usr/bin/example" : {
      "shouldTranslate" : false
    },
    "%@ already exist there. A backup of the file is kept." : {
      "localizations" : {
        "ja" : {
